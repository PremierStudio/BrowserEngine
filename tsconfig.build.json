{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/extension/background.ts",
    "src/extension/popup.ts",
    "src/extension/panel.ts",
    "src/extension/options.ts",
    "src/extension/nativeHost.ts"
  ]
}
