{
  "name": "@premierstudio/browser-engine",
  "version": "0.1.0",
  "private": false,
  "description": "An agent explores the product. CI replays the path with no AI. A broken step is a named report.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PremierStudio/BrowserEngine.git"
  },
  "type": "module",
  "bin": {
    "browser-engine": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "extension",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --no-warn-ignored",
    "format": "prettier --check .",
    "knip": "knip --max-issues 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "showcase": "vitest run tests/integration/chrome.showcase.test.ts",
    "coverage": "vitest run --coverage",
    "mutation": "stryker run stryker.config.ts",
    "survivors": "npm run build:scripts && node dist-scripts/survivors.js",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "build:extension": "tsc -p tsconfig.extension.json",
    "build": "tsc -p tsconfig.build.json && npm run build:extension",
    "prepack": "npm run build",
    "start": "npm run build && node dist/cli.js",
    "ci:local-run": "node dist/testing/clickGoMain.js",
    "reports": "vitest run --coverage --reporter junit --outputFile reports/junit.xml",
    "ci:survivors": "npm run mutation && npm run survivors",
    "ci": "npm run typecheck && npm run lint && npm run format && npm run knip && npm test && npm run coverage && npm run ci:survivors"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/api": "^9.6.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/chrome": "^0.2.9",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.32.2",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "puppeteer": "^25.6.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "fast-uri": "3.1.7",
    "qs": "6.16.0"
  }
}
