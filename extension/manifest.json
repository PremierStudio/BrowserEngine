{
  "manifest_version": 3,
  "name": "BrowserEngine",
  "version": "0.3.0",
  "description": "Drive this browser from an agent. Cockpit, settings, origin allow-list.",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "nativeMessaging",
    "activeTab",
    "storage",
    "sidePanel",
    "commands",
    "tabGroups",
    "alarms"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "BrowserEngine",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "open-cockpit": {
      "suggested_key": {
        "default": "Ctrl+Shift+E"
      },
      "description": "Open the BrowserEngine side-panel cockpit"
    },
    "kill-switch": {
      "suggested_key": {
        "default": "Ctrl+Shift+U"
      },
      "description": "Pause BrowserEngine and detach the debugger"
    }
  }
}
